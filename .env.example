# Настройки бота и сайта. Общая база данных; миграциями управляет API.
# Значения читаются при запуске; после изменений перезапустите соответствующие сервисы.
# Секреты и пароли не выводите в публичные логи.
# Шаблон для первого запуска. Не копируйте поверх уже заполненного .env.
# По просьбе владельца здесь сохранён действующий пароль администратора сайта.

# --- Telegram-бот ---
# Токен Telegram-бота от BotFather. Секрет; используется только сервером.
TOKEN=************************
# ID Telegram-канала. Сохранённая настройка; текущий основной код бота её не использует.
TG_CHANNEL_ID=-********************
# Числовой Telegram ID администратора бота; это не аккаунт администратора сайта.
ADMIN_ID=************
# Имя администратора Telegram-бота при создании его записи в базе.
ADMIN_NAME=admin
# Путь к исходному KMZ с местами внутри окружения бота (в Docker — внутри контейнера).
KMZ_PATH=geo_data/Покинутые_индустриальные_объекты.kmz
# Путь к CSV с адресами мест внутри окружения бота.
CSV_PATH=geo_data/lat_lon_full_address.csv
# True включает начальное заполнение мест из файлов; False — работа с существующим каталогом.
SEED_PLACES=False
# Источник начального импорта при SEED_PLACES=True: kmz, csv или both (сначала KMZ, затем CSV).
SEED_PLACES_SOURCE=csv
# CSV с местами: name,latitude,longitude; необязательные description,type,category,full_address.
# Путь внутри контейнера бота. Новые места попадают на модерацию; существующие координаты пропускаются.
PLACES_CSV_PATH=geo_data/places.csv
# True отправляет задачу синхронизации мест в очередь при запуске бота.
ENQUEUE_PLACES_SYNC_ON_STARTUP=True
# Сохранённый ключ Wikimapia; текущий основной код приложения его не использует.
WIKIMAPIA_API_KEY=REPLACE_WITH_WIKIMAPIA_API_KEY

# --- Общая PostgreSQL — бот, API и миграции ---
# Пользователь общей PostgreSQL для бота, API и миграций.
POSTGRES_USER='urbex'
# Пароль общей PostgreSQL. Изменение файла не меняет пароль в уже созданной базе.
POSTGRES_PASSWORD='local-only'
# Имя общей рабочей базы; для текущего каталога используется urbex_catalog.
POSTGRES_DB='urbex_catalog'
# Адрес PostgreSQL внутри Docker-сети: db. С компьютера подключайтесь к 127.0.0.1.
POSTGRES_HOST=db
# Порт PostgreSQL. В текущем локальном Compose и внутри Docker, и с компьютера — 5432.
POSTGRES_PORT=5432

# --- Подключение бота к общему Elasticsearch ---
# Общий Elasticsearch сайта и бота. В Compose подключение задаётся URBEX_ELASTICSEARCH_URL.
ELASTICSEARCH_HOST=http://elasticsearch:9200
# Сохранённый порт Elasticsearch. Текущий клиент бота берёт полный URL из ELASTICSEARCH_HOST.
ELASTICSEARCH_PORT=9200
# Пользователь Elasticsearch при запуске бота вне Compose.
ELASTICSEARCH_USER=elastic
# Встроенный Elasticsearch доступен только внутри Docker, без авторизации. В Compose используются URBEX_ELASTICSEARCH_USER/PASSWORD.
ELASTICSEARCH_PASSWORD=

# --- RabbitMQ и повторы задач ---
# Пользователь RabbitMQ для подключения бота и фонового worker.
RABBITMQ_USER=bot
# Пароль RabbitMQ; начальные учётные данные брокера.
RABBITMQ_PASSWORD=change_me
# Имя сервиса RabbitMQ внутри Docker-сети: rabbitmq.
RABBITMQ_HOST=rabbitmq
# AMQP-порт RabbitMQ (обычно 5672), не порт веб-панели управления.
RABBITMQ_PORT=5672
# Виртуальный хост RabbitMQ, в котором создаются очереди приложения.
RABBITMQ_VHOST=/
# Максимальное число повторов обработки сообщения при ошибке.
RABBITMQ_MAX_RETRY_ATTEMPTS=3
# Задержка между повторами обработки сообщения, в миллисекундах.
RABBITMQ_RETRY_DELAY_MS=5000
# Максимальное число попыток подключения к RabbitMQ.
RABBITMQ_CONNECTION_MAX_ATTEMPTS=10
# Задержка повторного подключения к RabbitMQ, в миллисекундах.
RABBITMQ_CONNECTION_RETRY_DELAY_MS=500

# --- Grafana ---
# Логин администратора Grafana; не относится к администратору сайта.
GF_SECURITY_ADMIN_USER=admin
# Начальный пароль Grafana; изменение переменной не сбрасывает пароль существующего пользователя.
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Сайт и API ---
# Точный адрес сайта (с протоколом и портом) для проверки Origin запросов. В production используется URBEX_PROD_ORIGIN.
URBEX_ORIGIN=http://localhost:3100
# Публичный HTTPS-адрес сайта для production Compose, например https://example.com.
URBEX_PROD_ORIGIN=https://example.com
# true разрешает отправку cookie авторизации только по HTTPS; для локального HTTP — false. Production Compose задаёт true.
URBEX_SECURE_COOKIE=false
# Режим API: development, test или production. Production Compose принудительно задаёт production.
URBEX_ENVIRONMENT=development
# Адрес API для frontend, запущенного через npm на компьютере. В контейнере frontend используется http://api:8000.
API_INTERNAL_URL=http://127.0.0.1:58000
# Публичный URL JSON-стиля MapLibre. Доступен браузеру; не размещайте здесь серверные секреты. Для production-frontend применяется при сборке.
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- Фотографии: MinIO и Telegram ---
# Имя пользователя / ключ доступа к приватному MinIO-хранилищу фотографий.
URBEX_S3_ACCESS_KEY=local-minio
# Секретный ключ MinIO. Используется API и при настройке контейнера хранилища.
URBEX_S3_SECRET_KEY=local-minio-change-me
# Серверный токен для чтения фотографий, загруженных через Telegram. Пустое значение в Compose использует основной TOKEN бота.
URBEX_TELEGRAM_BOT_TOKEN=

# --- Elasticsearch сайта ---
# Внутренний URL поискового Elasticsearch сайта; он отделён от поискового сервиса бота.
URBEX_ELASTICSEARCH_URL=http://elasticsearch:9200
# Имя индекса мест сайта. PostgreSQL остаётся основным хранилищем.
URBEX_ELASTICSEARCH_INDEX=urbex_places_v1
# Имя пользователя Elasticsearch сайта, если на сервере включена авторизация.
URBEX_ELASTICSEARCH_USER=elastic
# Пароль Elasticsearch сайта; пустой для локального сервиса без авторизации.
URBEX_ELASTICSEARCH_PASSWORD=

# --- Локальные Docker-образы ---
# Имя Docker-образа API для локального Compose; --no-build использует уже подготовленный образ.
URBEX_API_IMAGE=urbex-api:local
# Имя Docker-образа бота и worker в локальном Compose.
BOT_IMAGE=telegram-bot:local

# --- Учётные данные администратора сайта ---
# Сохранённый логин администратора сайта. Эта переменная сама не создаёт и не изменяет учётную запись.
URBEX_ADMIN_EMAIL=admin@example.com
# Сохранённый пароль администратора сайта. Изменение значения здесь не меняет хеш пароля в базе.
URBEX_ADMIN_PASSWORD=********************

# Сервис определения адреса по координатам; запрос только по кнопке, с кешем и ограничением частоты.
# Условия публичного сервиса: https://operations.osmfoundation.org/policies/nominatim/
URBEX_GEOCODER_URL=https://nominatim.openstreetmap.org

# Публичное имя Telegram-бота без @ для входа и регистрации через подтверждение в боте.
URBEX_TELEGRAM_BOT_USERNAME=urbanturizm_search_bot
