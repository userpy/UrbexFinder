# Telegram bot
TOKEN=0000000000:REPLACE_WITH_TELEGRAM_BOT_TOKEN
TG_CHANNEL_ID=-1000000000000
ADMIN_ID=123456789
ADMIN_NAME=admin
KMZ_PATH=geo_data/Покинутые_индустриальные_объекты.kmz
CSV_PATH=geo_data/lat_lon_full_address.csv

# Run initial places seeding from KMZ
SEED_PLACES=False

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mydatabase
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change_me

# RabbitMQ
RABBITMQ_USER=bot
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_MAX_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_CONNECTION_MAX_ATTEMPTS=10
RABBITMQ_CONNECTION_RETRY_DELAY_MS=500
ENQUEUE_PLACES_SYNC_ON_STARTUP=True
